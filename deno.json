{
  "tasks": {
    "dev": "deno run -A --unstable-net --node-modules-dir=manual main.ts",
    "start": "deno run -A --unstable-net --node-modules-dir=manual main.ts",
    "compile": "deno compile -A --unstable-net --node-modules-dir=manual --output dist/doors-server main.ts && deno task package",
    "compile:mac": "deno compile -A --unstable-net --node-modules-dir=manual --target aarch64-apple-darwin --output dist/doors-server-mac-arm64 main.ts",
    "compile:mac-x64": "deno compile -A --unstable-net --node-modules-dir=manual --target x86_64-apple-darwin --output dist/doors-server-mac-x64 main.ts",
    "compile:win": "deno compile -A --unstable-net --node-modules-dir=manual --target x86_64-pc-windows-msvc --output dist/doors-server-win.exe main.ts",
    "compile:linux": "deno compile -A --unstable-net --node-modules-dir=manual --target x86_64-unknown-linux-gnu --output dist/doors-server-linux main.ts",
    "package": "deno run -A scripts/packageDist.ts",
    "compile:all": "deno task compile:mac && deno task compile:mac-x64 && deno task compile:win && deno task compile:linux && deno task package",
    "release": "deno task compile:all",
    "test": "deno test -A --unstable-net --node-modules-dir=manual",
    "https-smoke": "deno run -A --unstable-net --node-modules-dir=manual scripts/httpsSmoke.ts",
    "lint": "deno lint",
    "types": "deno check main.ts",
    "check:imports": "deno run -A scripts/checkNoPrivateImports.ts"
  },
  "nodeModulesDir": "manual",
  "imports": {
    "@doors/bot-engine": "./bots/engine/index.ts",
    "@doors/bot-engine/math": "./bots/engine/math/index.ts",
    "@doors/bot-engine/engine": "./bots/engine/engine/index.ts",
    "@doors/bot-engine/look/combat-pitch": "./bots/engine/look/combatPitch.ts",
    "@doors/bot-engine/look/yaw-ease": "./bots/engine/look/yawEase.ts",
    "@doors/bot-engine/model": "./bots/engine/model/index.ts",
    "@doors/bot-engine/navigation": "./bots/engine/navigation/index.ts",
    "@doors/bot-engine/protocol": "./bots/engine/protocol/index.ts",
    "@doors/bot-engine/thoughts/": "./bots/engine/thoughts/",
    "@doors/bot-engine/pipeline": "./bots/engine/pipeline/index.ts",
    "@doors/bot-spec": "./bots/spec/src/index.ts",
    "@doors/bot-spec/config": "./bots/spec/src/config.ts",
    "@doors/bot-spec/model": "./bots/spec/src/model/index.ts",
    "@doors/bot-spec/protocol": "./bots/spec/src/protocol/index.ts",
    "@doors/bot-spec/schedule": "./bots/spec/src/schedule.ts",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/http": "jsr:@std/http@^1.1.2",
    "good-clock": "npm:good-clock@^1.3.0",
    "obscenity": "npm:obscenity@0.4.6",
    "socket.io": "npm:socket.io@^4.8.3",
    "socket.io-client": "npm:socket.io-client@^4.8.3",
    "express": "npm:express@^4.21.2",
    "cors": "npm:cors@^2.8.5",
    "react": "npm:react@18.3.1",
    "react/jsx-runtime": "npm:react@18.3.1/jsx-runtime",
    "ink": "npm:ink@5.2.1",
    "@types/express": "npm:@types/express@^4.17.21",
    "@types/cors": "npm:@types/cors@^2.8.17",
    "@types/react": "npm:@types/react@^18.3.18"
  },
  "permissions": {
    "my-app-perms": {
      "env": true,
      "read": true,
      "sys": true,
      "net": true
    }
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "deno.unstable"]
  },
  "test": {
    "exclude": [
      "bots/engine/thoughts/cadence_test.ts",
      "bots/engine/thoughts/click/",
      "bots/engine/thoughts/combatPitch/",
      "bots/engine/thoughts/halfWallVault/",
      "bots/engine/thoughts/floatWallDuck/",
      "bots/engine/thoughts/stuckWTurn/",
      "bots/engine/thoughts/helpers/dwellBreak_test.ts",
      "bots/engine/thoughts/helpers/navLayers_test.ts",
      "bots/engine/thoughts/helpers/playerAvoid_test.ts",
      "bots/engine/thoughts/perception/",
      "bots/engine/thoughts/targetEnemy/",
      "bots/engine/thoughts/useSkills/"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix",
        "no-unversioned-import",
        "no-irregular-whitespace",
        "jsx-curly-braces"
      ]
    }
  }
}
